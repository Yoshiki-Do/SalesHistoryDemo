@model SalesHistoryDemo.Models.SalesHistoryViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">
    <h1>Sales History</h1>
    <hr />

    <h2>Search Criteria</h2>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <form method="get" asp-controller="Home" asp-action="Index">
        <div class="row mb-3">
            <div class="col-md-3">
                <label for="startDate">Start</label>
                <input type="date"
                       id="startDate"
                       name="startDate"
                       class="form-control"
                       value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-3">
                <label for="endDate">End</label>
                <input type="date"
                       id="endDate"
                       name="endDate"
                       class="form-control"
                       value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>

        <div class="row md-3">
            <div class="col-md-3">
                <label for="customerName">Customer Name</label>
                <input type="text"
                       id="customerName"
                       name="customerName"
                       class="form-control"
                       value="@Model.CustomerName" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <label for="sortOrder">Sort By</label>
                <select id="sortOrder"
                        name="sortOrder"
                        class="form-select">
                    <option value="date_desc"
                            selected="@(Model.SortOrder == "date_desc")">
                        Sale Date (Newest First)
                    </option>
                    <option value="amount_desc"
                            selected="@(Model.SortOrder == "amount_desc")">
                        Amount (Hightest First)
                    </option>
                </select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <hr class="mt-4" />

    <h2>Search Result</h2>

    <p>
        @Model.Sales.Count()
        @(Model.Sales.Count() == 1 ? "record" : "records") found.
    </p>

    <p>
        Page @Model.CurrentPage of
        @Math.Max(1,(int)Math.Ceiling(
        Model.TotalRecords / (double)Model.PageSize))
    </p>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Slip Number</th>
                <th>Date</th>
                <th>Customer Name</th>
                <th class="text-end">Amount</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Sales.Any())
            {
                @foreach (var sale in Model.Sales)
                {
                    <tr>
                        <td>@sale.SlipNumber</td>
                        <td>@sale.SaleDate.ToString("yyyy/MM/dd")</td>
                        <td>@sale.CustomerName</td>
                        <td class="text-end">@sale.Amount.ToString("N0")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        No record found.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @{
        var totalPages = Math.Max(1,
        (int)Math.Ceiling(
        Model.TotalRecords / (double)Model.PageSize));
    }

    <nav aria-label="Sales history pages">
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="pageg-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       asp-route-customerName="@Model.CustomerName"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-page="@(Model.CurrentPage - 1)">
                        Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       asp-route-customerName="@Model.CustomerName"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-page="@i">
                        @i
                    </a>
                </li>
            }

            @if (Model.CurrentPage < totalPages)
            {
                <li class="pageg-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       asp-route-customerName="@Model.CustomerName"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-page="@(Model.CurrentPage + 1)">
                        Next
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>
